# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it will never be committed.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser. Also under
# Project Settings > API. Guards guest access to trips (see supabase/schema.sql).
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps — needs the "Maps JavaScript API" and "Places API" enabled,
# with an API key restricted to your domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic — for preference extraction
ANTHROPIC_API_KEY=

# Base URL of this app, used to build OAuth redirect links.
# For local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
