# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it will never be committed.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser. Also under
# Project Settings > API. Guards guest access to trips (see supabase/schema.sql).
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps — needs the "Maps JavaScript API" and "Places API" enabled,
# with an API key restricted to your domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic — for preference extraction
ANTHROPIC_API_KEY=

# Base URL of this app, used to build OAuth redirect links.
# For local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twilio — WhatsApp integration (legacy v1). Account SID + Auth Token from
# the Twilio Console; WHATSAPP_NUMBER is the "whatsapp:+1..." sender Twilio
# gave you (sandbox or a registered number). DISPLAY_NUMBER is the
# human-readable form shown in the UI ("+1 415 523 8886").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY_NUMBER=

# Twilio — SMS/MMS integration (v2's "forward a place" + group nudges).
# Uses the same Account SID/Auth Token above. SMS_NUMBER is a real,
# SMS+MMS-capable number you own (NOT the WhatsApp sandbox number above —
# that one can't send/receive plain SMS). MESSAGING_SERVICE_SID is the
# Messaging Service that number belongs to (Messaging > Services in the
# console) — Conversations uses it to originate group-thread messages.
TWILIO_SMS_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Set to "true" to let the organizer-invite flow skip re-asking consent from
# a phone that's already opted in on a prior trip (adds them straight to the
# new trip's membership + Conversation instead of sending a join link).
# Leave unset/false until the privacy policy has a line covering this.
ENABLE_CONTACT_MATCH_INVITES=

# Meta Cloud API — v2's WhatsApp integration (separate from the Twilio one
# above, which v1 still uses). From the app's WhatsApp > API Setup page.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Any string you make up — paste the same value into Meta's webhook config.
META_WEBHOOK_VERIFY_TOKEN=

# Meta app secret (App settings > Basic > App secret) — used to verify the
# X-Hub-Signature-256 header on incoming WhatsApp webhook calls, so only
# Meta can post to the webhook. Server-only.
META_APP_SECRET=

# Shared secret for the scheduled jobs under /api/v2/cron (see vercel.json).
# Required — the cron routes refuse every request while it's unset. On
# Vercel, add it as a project env var and Vercel's cron scheduler sends it
# automatically as "Authorization: Bearer <CRON_SECRET>". Any long random
# string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
